{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grocerycart",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://grocerycart.henryreeb3.workers.dev",
    "KROGER_REDIRECT_URI": "https://grocerycart.henryreeb3.workers.dev/api/oauth/callback"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grocerycart",
      "database_id": "8c2abc3c-b847-486e-a3c3-9c20ac2cde5b"
    }
  ],
  "triggers": {
    "crons": ["0 * * * THU"]
  }
}
